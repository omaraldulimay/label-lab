{
  "id": "labellab01",
  "name": "Label Lab Pruefung",
  "active": false,
  "nodes": [
    {"parameters": {}, "id": "n1", "name": "Start", "type": "n8n-nodes-base.manualTrigger",
     "typeVersion": 1, "position": [0, 0]},
    {"parameters": {"method": "POST", "url": "http://api:8000/load", "options": {}},
     "id": "n2", "name": "Daten holen", "type": "n8n-nodes-base.httpRequest",
     "typeVersion": 4.2, "position": [240, 0]},
    {"parameters": {"method": "POST", "url": "http://api:8000/check-all", "options": {"timeout": 7200000}},
     "id": "n3", "name": "Alle Produkte pruefen", "type": "n8n-nodes-base.httpRequest",
     "typeVersion": 4.2, "position": [480, 0]},
    {"parameters": {"method": "POST", "url": "http://api:8000/export", "options": {"timeout": 60000}},
     "id": "n4", "name": "Ergebnisse exportieren", "type": "n8n-nodes-base.httpRequest",
     "typeVersion": 4.2, "position": [720, 0]},
    {"parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "loose"},
       "conditions": [{"id": "c1", "leftValue": "={{ $('Alle Produkte pruefen').item.json.red_count }}",
                       "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}],
       "combinator": "and"}, "options": {}},
     "id": "n5", "name": "Rote Produkte?", "type": "n8n-nodes-base.if",
     "typeVersion": 2.2, "position": [960, 0]},
    {"parameters": {"method": "POST", "url": "http://api:8000/alert", "sendBody": true,
       "specifyBody": "json",
       "jsonBody": "={{ JSON.stringify({red_count: $('Alle Produkte pruefen').item.json.red_count, red: $('Alle Produkte pruefen').item.json.red.slice(0, 20)}) }}",
       "options": {}},
     "id": "n6", "name": "Alarm Webhook", "type": "n8n-nodes-base.httpRequest",
     "typeVersion": 4.2, "position": [1200, -80]},
    {"parameters": {"jsCode": "const n = $('Alle Produkte pruefen').item.json.red_count;\nconsole.log('ALARM: ' + n + ' rote Produkte');\nreturn [{json: {alarm: true, red_count: n}}];"},
     "id": "n7", "name": "Alarm Log", "type": "n8n-nodes-base.code",
     "typeVersion": 2, "position": [1440, -80]},
    {"parameters": {"jsCode": "return [{json: {alarm: false}}];"},
     "id": "n8", "name": "Alles in Ordnung", "type": "n8n-nodes-base.code",
     "typeVersion": 2, "position": [1200, 100]}
  ],
  "connections": {
    "Start": {"main": [[{"node": "Daten holen", "type": "main", "index": 0}]]},
    "Daten holen": {"main": [[{"node": "Alle Produkte pruefen", "type": "main", "index": 0}]]},
    "Alle Produkte pruefen": {"main": [[{"node": "Ergebnisse exportieren", "type": "main", "index": 0}]]},
    "Ergebnisse exportieren": {"main": [[{"node": "Rote Produkte?", "type": "main", "index": 0}]]},
    "Rote Produkte?": {"main": [[{"node": "Alarm Webhook", "type": "main", "index": 0}],
                                 [{"node": "Alles in Ordnung", "type": "main", "index": 0}]]},
    "Alarm Webhook": {"main": [[{"node": "Alarm Log", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
